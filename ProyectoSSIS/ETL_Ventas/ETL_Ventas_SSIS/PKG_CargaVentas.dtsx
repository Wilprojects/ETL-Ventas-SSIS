      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{60FB9490-BBB0-4FD3-8714-607CB9383DC9}"
          SQLTask:SqlStatementSource="IF DB_NAME() &lt;&gt; N'ETLVentasDB'&#xA;BEGIN&#xA;    THROW 50001,&#xA;          N'La conexión SSIS no apunta a la base de datos ETLVentasDB.',&#xA;          1;&#xA;END;&#xA;&#xA;IF OBJECT_ID(N'dbo.Cliente', N'U') IS NULL&#xA;BEGIN&#xA;    THROW 50002,&#xA;          N'No existe la tabla dbo.Cliente.',&#xA;          1;&#xA;END;&#xA;&#xA;IF OBJECT_ID(N'dbo.Venta', N'U') IS NULL&#xA;BEGIN&#xA;    THROW 50003,&#xA;          N'No existe la tabla dbo.Venta.',&#xA;          1;&#xA;END;&#xA;&#xA;IF NOT EXISTS&#xA;(&#xA;    SELECT 1&#xA;    FROM dbo.Cliente&#xA;)&#xA;BEGIN&#xA;    THROW 50004,&#xA;          N'La tabla dbo.Cliente no contiene registros para realizar el Lookup.',&#xA;          1;&#xA;END;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
